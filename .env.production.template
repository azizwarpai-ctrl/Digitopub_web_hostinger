# =====================================================
# DATABASE (MySQL/MariaDB) — REQUIRED
# =====================================================
# Used by Prisma ORM. Must point to your production database.
DATABASE_URL="mysql://<user>:<password>@<host>:<port>/scientific_journals_db"

# Individual credentials (Optional, but good for reference/scripts)
DATABASE_HOST="<host>"
DATABASE_PORT="3306"
DATABASE_NAME="scientific_journals_db"
DATABASE_USER="<user>"
DATABASE_PASSWORD="<password>"

# =====================================================
# AUTHENTICATION — REQUIRED
# =====================================================
# Used by jose for JWT generation and validation in Next.js Middleware and Hono API.
# Generate a strong 64-character secret, e.g., using `openssl rand -base64 64`
JWT_SECRET="<your_secure_random_jwt_secret>"

# =====================================================
# APPLICATION & SECURITY — REQUIRED
# =====================================================
# Tells Next.js to optimize for production
NODE_ENV="production"

# The public facing URL of your application (Used by Hono RPC client `hc`)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Important for Hono API CORS!
# Comma-separated list of origins allowed to interact with the API.
ALLOWED_ORIGINS="https://your-domain.com,https://www.your-domain.com"

# Bearer token protecting the recurring-job HTTP endpoints
# (/api/ojs/sync and /api/cron/*). Generate with: openssl rand -hex 32
# REQUIRED for scheduled sync/metrics jobs — see docs/ops/cron-schedule.md.
CRON_SECRET="<64-hex-random>"

# =====================================================
# OJS CONFIGURATION (direct MySQL — the mode production uses)
# =====================================================
# Requires SiteGround Remote MySQL + whitelisting of this app's outbound IP.
# The DB user must be GRANT SELECT only.
OJS_DATABASE_HOST="<ojs_host>"
OJS_DATABASE_PORT="3306"
OJS_DATABASE_NAME="<ojs_db>"
OJS_DATABASE_USER="<ojs_readonly_user>"
OJS_DATABASE_PASSWORD="<ojs_password>"

# OJS URLs. OJS_BASE_URL is the server-side base; the PUBLIC/NEXT_PUBLIC pair
# is what browsers see (journals.digitopub.com since the cutover).
OJS_BASE_URL="https://journals.digitopub.com"
PUBLIC_OJS_BASE_URL="https://journals.digitopub.com"
NEXT_PUBLIC_OJS_BASE_URL="https://journals.digitopub.com"

# PHP bridge endpoints deployed on the OJS host (user provisioning / PDF bridge).
# The API key is sent ONLY via header, never as a URL param.
# OJS_BRIDGE_URL is optional — defaults to ${OJS_BASE_URL}/ojs-user-bridge.php.
OJS_API_KEY="<ojs_bridge_api_key>"
OJS_BRIDGE_URL="https://journals.digitopub.com/ojs-user-bridge.php"
OJS_PDF_BRIDGE_URL="https://journals.digitopub.com/ojs-pdf-bridge.php"

# SSO_SECRET (legacy): the sso_login.php session-forging handoff was REMOVED —
# it cannot work on OJS 3.4+ (the 3.3-era bootstrap it required is gone).
# Registration now hands users to the OJS login page directly. Do not set.
# SSO_SECRET=""

# Legacy HTTP-proxy mode (only if direct MySQL is impossible)
# OJS_API_URL="https://<ojs-host>/api/api.php"

# Synchronization toggles (consumed by /api/ojs/sync and the CLI cron script)
OJS_SYNC_ENABLED="true"
# Drift self-heal throttle in ms (0 disables). Default 300000 (5 min).
# OJS_DRIFT_CHECK_INTERVAL_MS="300000"

# =====================================================
# EMAIL / OTP (SMTP via nodemailer)
# =====================================================
SMTP_HOST="<smtp_host>"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="<smtp_user>"
SMTP_PASSWORD="<smtp_password>"
SMTP_FROM_EMAIL="<from_address>"

# Controls how OTP verification codes are delivered.
# Options: "console" (dev only), "email" (requires SMTP above), "disabled" (fail-closed)
OTP_DELIVERY_METHOD="email"

# =====================================================
# FILE UPLOADS & AUDIO STORAGE
# =====================================================
MAX_FILE_SIZE_MB="50"
# Max data rows per uploaded notification subscriber list (XLSX/CSV/TXT). Default 10000.
NOTIFY_IMPORT_MAX_ROWS="10000"
ALLOWED_FILE_TYPES="pdf,doc,docx,txt,jpg,png"
UPLOAD_DIR="./uploads"
# Local audio-abstract storage dir (used when S3 is not configured)
AUDIO_STORAGE_DIR="./uploads/audio"
# Optional S3 storage for audio abstracts
# S3_ENDPOINT="" S3_REGION="" S3_BUCKET="" S3_ACCESS_KEY_ID="" S3_SECRET_ACCESS_KEY="" S3_FORCE_PATH_STYLE="false"

# =====================================================
# SEEDING CREDENTIALS (Required for first-time init)
# =====================================================
ADMIN_EMAIL="<admin_email>"
ADMIN_PASSWORD="<admin_password>"
SUPPORT_EMAIL="<support_email>"
SUPPORT_PASSWORD="<support_password>"

# =====================================================
# RUNTIME INITIALIZATION (Required for init.ts)
# =====================================================
# Set to "true" to enable automatic DB migration + seeding on startup.
# Should only be "true" during the initial deployment or after schema changes.
ALLOW_PROD_DB_INIT="false"

# =====================================================
# UIET-P1 — ORCID PUBLIC-USER IDENTITY (REQUIRED FOR P1)
# =====================================================
# Register the application at https://orcid.org/developer-tools
# Production redirect URI must exactly match the URL configured at ORCID.
ORCID_CLIENT_ID="<orcid_client_id>"
ORCID_CLIENT_SECRET="<orcid_client_secret>"
ORCID_REDIRECT_URI="https://your-domain.com/api/auth/orcid/callback"

# HMAC secrets — generate each with: openssl rand -base64 64
# CRITICAL: rotating IDENTITY_COOKIE_SECRET invalidates every live cookie.
IDENTITY_COOKIE_SECRET="<64-byte-random>"
ORCID_STATE_SECRET="<64-byte-random>"
EVENT_IP_HASH_SALT_SEED="<64-byte-random>"
# Publication-alert links (confirm / manage / unsubscribe). Required in production.
# CRITICAL: rotating it breaks every manage and unsubscribe link already emailed.
NOTIFY_TOKEN_SECRET="<64-byte-random>"

# Feature flag — keep "false" in production until the ops team is ready
# to allow digitopub to write ORCID iDs into OJS user_settings on first
# email-match login. Every such write is audited in audit_ojs_writes.
ENABLE_ORCID_OJS_BACKFILL="false"

# Master switch for the UIET-P1 surface area. Flip to "true" only after
# DB migrations have run AND scripts/backfill-ojs-metrics.ts --confirm-once
# has been executed.
UIET_P1_ENABLED="false"

# =====================================================
# BILLING (only if Stripe billing is live)
# =====================================================
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
