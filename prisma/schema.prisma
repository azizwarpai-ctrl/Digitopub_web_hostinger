generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model AdminUser {
  id                   BigInt             @id @default(autoincrement())
  email                String             @unique @db.VarChar(255)
  full_name            String             @db.VarChar(255)
  role                 String             @default("admin") @db.VarChar(50)
  password_hash        String             @db.VarChar(255)
  created_at           DateTime           @default(now())
  updated_at           DateTime           @default(now()) @updatedAt
  country              String?            @db.VarChar(90)
  phone                String?            @db.VarChar(32)
  affiliation          String?            @db.VarChar(255)
  department           String?            @db.VarChar(255)
  orcid                String?            @db.VarChar(255)
  biography            String?            @db.Text
  checkout_session     CheckoutSession?
  created_journals     Journal[]          @relation("CreatedBy")
  published_articles   PublishedArticle[] @relation("PublishedBy")
  assigned_reviews     Review[]           @relation("AssignedBy")
  assigned_submissions Submission[]       @relation("AssignedTo")
  created_submissions  Submission[]       @relation("CreatedBy")
  subscription         Subscription?
  updated_settings     SystemSetting[]    @relation("UpdatedBy")
  uploaded_audios      ArticleAudio[]     @relation("UploadedBy")
  password_reset_tokens PasswordResetToken[]

  @@index([email])
  @@map("admin_users")
}

model Journal {
  id                 BigInt             @id @default(autoincrement())
  title              String             @db.Text
  abbreviation       String?            @db.VarChar(100)
  issn               String?            @unique @db.VarChar(20)
  e_issn             String?            @db.VarChar(20)
  description        String?            @db.Text
  field              String             @db.VarChar(100)
  publisher          String?            @db.VarChar(255)
  editor_in_chief    String?            @db.VarChar(255)
  frequency          String?            @db.VarChar(50)
  submission_fee     Decimal?           @default(0.00) @db.Decimal(10, 2)
  publication_fee    Decimal?           @default(0.00) @db.Decimal(10, 2)
  cover_image_url    String?            @db.VarChar(500)
  website_url        String?            @db.VarChar(500)
  status             String?            @default("active") @db.VarChar(20)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @default(now()) @updatedAt
  created_by         BigInt?
  ojs_id             String?            @unique @db.VarChar(50)
  ojs_path           String?            @unique @db.VarChar(100)
  aims_and_scope     String?            @db.Text
  author_guidelines  String?            @db.Text
  last_synced_at     DateTime?
  creator            AdminUser?         @relation("CreatedBy", fields: [created_by], references: [id])
  published_articles PublishedArticle[]
  submissions        Submission[]
  ojs_snapshot       OjsJournalSnapshot?
  pricing_plans      PricingPlan[]

  @@index([field])
  @@index([status])
  @@index([issn])
  @@index([ojs_id])
  @@index([created_by], map: "journals_created_by_fkey")
  @@map("journals")
}

model Submission {
  id                         BigInt             @id @default(autoincrement())
  journal_id                 BigInt
  manuscript_title           String             @db.Text
  abstract                   String             @db.Text
  keywords                   Json?
  submission_type            String?            @db.VarChar(50)
  author_name                String             @db.VarChar(255)
  author_email               String             @db.VarChar(255)
  corresponding_author_name  String?            @db.VarChar(255)
  corresponding_author_email String?            @db.VarChar(255)
  co_authors                 Json?
  manuscript_file_url        String?            @db.VarChar(500)
  supplementary_files        Json?
  status                     String?            @default("submitted") @db.VarChar(50)
  submission_date            DateTime           @default(now())
  last_updated               DateTime           @default(now()) @updatedAt
  assigned_to                BigInt?
  notes                      String?            @db.Text
  created_by                 BigInt?
  ojs_submission_id          String?            @unique @db.VarChar(50)
  published_articles         PublishedArticle[]
  reviews                    Review[]
  assignee                   AdminUser?         @relation("AssignedTo", fields: [assigned_to], references: [id])
  creator                    AdminUser?         @relation("CreatedBy", fields: [created_by], references: [id])
  journal                    Journal            @relation(fields: [journal_id], references: [id], onDelete: Cascade)

  @@index([journal_id])
  @@index([status])
  @@index([author_email])
  @@index([submission_date])
  @@index([ojs_submission_id])
  @@index([assigned_to], map: "submissions_assigned_to_fkey")
  @@index([created_by], map: "submissions_created_by_fkey")
  @@map("submissions")
}

model Review {
  id                   BigInt     @id @default(autoincrement())
  submission_id        BigInt
  reviewer_name        String     @db.VarChar(255)
  reviewer_email       String     @db.VarChar(255)
  reviewer_affiliation String?    @db.VarChar(255)
  review_status        String?    @default("pending") @db.VarChar(50)
  recommendation       String?    @db.VarChar(50)
  comments_to_author   String?    @db.Text
  comments_to_editor   String?    @db.Text
  review_date          DateTime?
  created_at           DateTime   @default(now())
  assigned_by          BigInt?
  assigner             AdminUser? @relation("AssignedBy", fields: [assigned_by], references: [id])
  submission           Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@index([submission_id])
  @@index([review_status])
  @@index([reviewer_email])
  @@index([assigned_by], map: "reviews_assigned_by_fkey")
  @@map("reviews")
}

model PublishedArticle {
  id                 BigInt     @id @default(autoincrement())
  submission_id      BigInt
  journal_id         BigInt
  doi                String?    @unique @db.VarChar(255)
  volume             Int?
  issue              Int?
  page_start         Int?
  page_end           Int?
  publication_date   DateTime   @db.Date
  pdf_url            String?    @db.VarChar(500)
  html_url           String?    @db.VarChar(500)
  /// DEPRECATED (UIET-P1) — use metrics_article_monthly. Retained for backward compat with legacy seed data.
  views_count        Int?       @default(0)
  /// DEPRECATED (UIET-P1) — use metrics_article_monthly. Retained for backward compat with legacy seed data.
  downloads_count    Int?       @default(0)
  /// DEPRECATED (UIET-P1) — use metrics_article_monthly. Retained for backward compat with legacy seed data.
  citations_count    Int?       @default(0)
  created_at         DateTime   @default(now())
  published_by       BigInt?
  ojs_publication_id String?    @unique @db.VarChar(50)
  journal            Journal    @relation(fields: [journal_id], references: [id], onDelete: Cascade)
  publisher          AdminUser? @relation("PublishedBy", fields: [published_by], references: [id])
  submission         Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@index([journal_id])
  @@index([doi])
  @@index([publication_date])
  @@index([ojs_publication_id])
  @@index([published_by], map: "published_articles_published_by_fkey")
  @@index([submission_id], map: "published_articles_submission_id_fkey")
  @@map("published_articles")
}

model SystemSetting {
  id            BigInt     @id @default(autoincrement())
  setting_key   String     @unique @db.VarChar(255)
  setting_value Json
  description   String?    @db.Text
  updated_at    DateTime   @default(now()) @updatedAt
  updated_by    BigInt?
  updater       AdminUser? @relation("UpdatedBy", fields: [updated_by], references: [id])

  @@index([setting_key])
  @@index([updated_by], map: "system_settings_updated_by_fkey")
  @@map("system_settings")
}

model Message {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(255)
  email        String   @db.VarChar(255)
  subject      String   @db.VarChar(255)
  message      String   @db.Text
  message_type String   @db.VarChar(50)
  status       String   @default("unread") @db.VarChar(50)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@map("messages")
}

model HelpCategory {
  id         BigInt      @id @default(autoincrement())
  title      String      @db.VarChar(255)
  slug       String      @unique @db.VarChar(255)
  created_at DateTime    @default(now())
  updated_at DateTime    @default(now()) @updatedAt
  topics     HelpTopic[]

  @@map("help_categories")
}

model HelpTopic {
  id          BigInt       @id @default(autoincrement())
  category_id BigInt
  title       String       @db.VarChar(255)
  content     String       @db.LongText
  order       Int          @default(0)
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @default(now()) @updatedAt
  category    HelpCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@index([category_id])
  @@index([is_active])
  @@map("help_topics")
}

model Solution {
  id            BigInt   @id @default(autoincrement())
  title         String   @db.VarChar(255)
  description   String   @db.Text
  icon          String?  @db.VarChar(100)
  features      Json?
  display_order Int      @default(0)
  is_published  Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  @@index([is_published, display_order])
  @@map("solutions")
}

/// Admin password-reset links (#165). Separate from verification_codes so the
/// login-OTP flow is untouched. Only a bcrypt hash of the link secret is
/// stored; rows are single-use (used_at) and expire after 15 minutes.
model PasswordResetToken {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  token_hash String    @db.VarChar(72)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       AdminUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

model VerificationCode {
  id             BigInt    @id @default(autoincrement())
  user_id        BigInt
  email          String    @db.VarChar(255)
  code           String    @db.VarChar(72)
  expires_at     DateTime
  used           Boolean   @default(false)
  created_at     DateTime  @default(now())
  attempts       Int       @default(0)
  last_failed_at DateTime?
  locked_until   DateTime?

  @@index([email])
  @@index([code])
  @@map("verification_codes")
}

/// TODO(stream-b): unused — the legacy sso_login.php handoff was removed
/// (dead on OJS 3.4+). Repurpose for the OIDC provider's auth codes or drop
/// via migration when Stream B (unified SSO) lands. No code references this.
model OjsSsoToken {
  id         String   @id @default(uuid())
  token      String   @unique @db.VarChar(128)
  email      String   @db.VarChar(255)
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([token])
  @@index([email])
  @@map("ojs_sso_tokens")
}

model EmailTemplate {
  id           BigInt     @id @default(autoincrement())
  name         String     @unique @db.VarChar(100)
  subject      String     @db.VarChar(500)
  html_content String     @db.LongText
  text_content String?    @db.LongText
  variables    Json?
  description  String?    @db.Text
  is_active    Boolean    @default(true)
  created_at   DateTime   @default(now())
  updated_at   DateTime   @default(now()) @updatedAt
  email_logs   EmailLog[]

  @@index([is_active])
  @@index([name])
  @@map("email_templates")
}

model EmailLog {
  id            BigInt         @id @default(autoincrement())
  template_id   BigInt?
  to_email      String         @db.VarChar(255)
  subject       String         @db.VarChar(500)
  status        String         @default("pending") @db.VarChar(50)
  error_message String?        @db.Text
  sent_at       DateTime?
  created_at    DateTime       @default(now())
  template      EmailTemplate? @relation(fields: [template_id], references: [id])

  @@index([template_id])
  @@index([status])
  @@index([to_email])
  @@map("email_logs")
}

model PricingPlan {
  id                  BigInt            @id @default(autoincrement())
  name                String            @db.VarChar(100)
  slug                String?           @unique @db.VarChar(100)
  description         String?           @db.Text
  short_description   String?           @db.VarChar(500)
  price               Decimal           @db.Decimal(10, 2)
  currency            String            @default("USD") @db.VarChar(3)
  billing_interval    String            @default("one_time") @db.VarChar(20)
  features            Json?
  icon_key            String?           @db.VarChar(50)
  image_url           String?           @db.VarChar(500)
  cta_label           String            @default("Get Started") @db.VarChar(100)
  cta_url             String?           @db.VarChar(500)
  stripe_price_id     String?           @unique @db.VarChar(255)
  is_active           Boolean           @default(true)
  is_popular          Boolean           @default(false)
  is_featured         Boolean           @default(false)
  sort_order          Int               @default(0)
  available_from      DateTime?
  available_until     DateTime?
  journal_id          BigInt?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @default(now()) @updatedAt
  checkout_sessions   CheckoutSession[]
  subscriptions       Subscription[]
  journal             Journal?          @relation(fields: [journal_id], references: [id], onDelete: SetNull)

  @@index([is_active, sort_order])
  @@index([journal_id])
  @@map("pricing_plans")
}

model CheckoutSession {
  id                 BigInt      @id @default(autoincrement())
  admin_user_id      BigInt      @unique
  pricing_plan_id    BigInt
  stripe_checkout_id String      @unique @db.VarChar(255)
  url                String      @db.VarChar(500)
  expires_at         DateTime
  created_at         DateTime    @default(now())
  admin_user         AdminUser   @relation(fields: [admin_user_id], references: [id], onDelete: Cascade)
  pricing_plan       PricingPlan @relation(fields: [pricing_plan_id], references: [id], onDelete: Cascade)

  @@index([pricing_plan_id], map: "checkout_sessions_pricing_plan_id_fkey")
  @@map("checkout_sessions")
}

model Subscription {
  id                     BigInt      @id @default(autoincrement())
  admin_user_id          BigInt      @unique
  pricing_plan_id        BigInt
  stripe_customer_id     String      @unique @db.VarChar(255)
  stripe_subscription_id String      @unique @db.VarChar(255)
  status                 String      @db.VarChar(50)
  current_period_end     DateTime
  created_at             DateTime    @default(now())
  updated_at             DateTime    @default(now()) @updatedAt
  invoices               Invoice[]
  admin_user             AdminUser   @relation(fields: [admin_user_id], references: [id])
  pricing_plan           PricingPlan @relation(fields: [pricing_plan_id], references: [id])

  @@index([pricing_plan_id], map: "subscriptions_pricing_plan_id_fkey")
  @@map("subscriptions")
}

model Invoice {
  id                BigInt       @id @default(autoincrement())
  subscription_id   BigInt
  amount            Decimal      @db.Decimal(10, 2)
  status            String       @db.VarChar(50)
  stripe_invoice_id String       @unique @db.VarChar(255)
  invoice_url       String?      @db.VarChar(500)
  created_at        DateTime     @default(now())
  subscription      Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([subscription_id])
  @@map("invoices")
}

model AboutSection {
  id            BigInt      @id @default(autoincrement())
  block_type    String      @db.VarChar(50)
  title         String?     @db.VarChar(255)
  subtitle      String?     @db.Text
  content       String?     @db.LongText
  display_order Int         @default(0)
  is_active     Boolean     @default(true)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @default(now()) @updatedAt
  section_key   String?     @unique @db.VarChar(50)
  items         AboutItem[]

  @@index([is_active, display_order])
  @@map("about_sections")
}

model AboutItem {
  id            BigInt       @id @default(autoincrement())
  section_id    BigInt
  title         String?      @db.VarChar(255)
  description   String?      @db.Text
  icon          String?      @db.VarChar(50)
  color_theme   String?      @db.VarChar(50)
  display_order Int          @default(0)
  section       AboutSection @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@index([section_id])
  @@map("about_items")
}

// =====================================================================
// UIET-P1 — ORCID identity, engagement tracking, OA-aware PDF gating
// =====================================================================

/// Raw engagement log. One row per view / download / citation_export.
model UserEvent {
  id              BigInt   @id @default(autoincrement())
  orcid           String?  @db.VarChar(19)
  ip_hash         String?  @db.Char(64)
  ua_hash         String?  @db.Char(64)
  article_id      BigInt
  journal_id      BigInt
  galley_id       BigInt?
  event_type      String   @db.VarChar(32)
  source          String   @db.VarChar(32)
  citation_format String?  @db.VarChar(16)
  event_meta      Json?
  dedup_key       String   @db.Char(64)
  view_day        String?  @db.Char(10)
  created_at      DateTime @default(now())

  @@unique([article_id, event_type, dedup_key, view_day], map: "uq_user_event_view_dedup")
  @@index([orcid, created_at])
  @@index([article_id, event_type, created_at])
  @@index([created_at])
  @@map("user_event")
}

/// Daily aggregates per (article, day, source).
model MetricsArticleDaily {
  id               BigInt   @id @default(autoincrement())
  article_id       BigInt
  journal_id       BigInt
  day              String   @db.Char(10)
  views            Int      @default(0)
  unique_views     Int      @default(0)
  downloads        Int      @default(0)
  unique_downloads Int      @default(0)
  citations        Int      @default(0)
  source           String   @default("digitopub") @db.VarChar(32)
  computed_at      DateTime @default(now())

  @@unique([article_id, day, source], map: "uq_daily_article_day_source")
  @@index([journal_id, day])
  @@index([day])
  @@map("metrics_article_daily")
}

/// Monthly roll-up per (article, year, month, source).
model MetricsArticleMonthly {
  id               BigInt   @id @default(autoincrement())
  article_id       BigInt
  journal_id       BigInt
  year             Int
  month            Int
  views            Int      @default(0)
  unique_views     Int      @default(0)
  downloads        Int      @default(0)
  unique_downloads Int      @default(0)
  citations        Int      @default(0)
  source           String   @default("digitopub") @db.VarChar(32)
  computed_at      DateTime @default(now())

  @@unique([article_id, year, month, source], map: "uq_monthly_article_year_month_source")
  @@index([journal_id, year, month])
  @@index([year, month])
  @@map("metrics_article_monthly")
}

/// Lifetime per-ORCID totals. Updated by the nightly aggregation job.
model UserMetrics {
  orcid         String   @id @db.VarChar(19)
  views         Int      @default(0)
  downloads     Int      @default(0)
  citations     Int      @default(0)
  first_seen_at DateTime
  last_event_at DateTime
  updated_at    DateTime @default(now()) @updatedAt

  @@index([last_event_at])
  @@map("user_metrics")
}

/// Post-deletion blocklist. Cookies with iat below cookie_iat_min are rejected.
model RevokedOrcid {
  orcid          String   @id @db.VarChar(19)
  revoked_at     DateTime @default(now())
  cookie_iat_min Int

  @@map("revoked_orcids")
}

/// digitopub-side cache of orcid -> ojs_user_id. Survives cookie clears.
model UserOrcidLink {
  id             BigInt   @id @default(autoincrement())
  orcid          String   @unique @db.VarChar(19)
  ojs_user_id    BigInt
  email_hash     String?  @db.Char(64)
  linked_at      DateTime @default(now())
  link_source    String   @db.VarChar(32)
  ojs_backfilled Boolean  @default(false)

  @@index([ojs_user_id])
  @@map("user_orcid_links")
}

/// Append-only audit log of every write digitopub has performed on the OJS database.
model AuditOjsWrite {
  id             BigInt    @id @default(autoincrement())
  request_id     String    @db.VarChar(36)
  orcid          String    @db.VarChar(19)
  ojs_user_id    BigInt
  ojs_table      String    @db.VarChar(64)
  ojs_column_set String    @db.Text
  planned_at     DateTime  @default(now())
  success        Boolean?
  resolved_at    DateTime?
  error          String?   @db.Text
  reason         String    @db.VarChar(64)

  @@index([orcid])
  @@index([ojs_user_id])
  @@index([planned_at])
  @@map("audit_ojs_writes")
}

// =====================================================================
// Initiative B — per-article audio (manager-uploaded)
// =====================================================================

/// Manager-uploaded audio per OJS article, per locale.
///
/// Keyed by OJS-side identity (`ojs_journal_id` matches `Journal.ojs_id`,
/// `submission_id` matches OJS `submissions.submission_id`) so the row
/// survives publication versioning on the OJS side. Locale uses the empty
/// string as the "default / unilingual" sentinel — MySQL UNIQUE treats
/// every NULL as distinct, which would defeat the one-per-locale rule,
/// so the column is NOT NULL with `""` as the default value.
///
/// The actual file lives in object storage at `storage_key`; this row is
/// the canonical handle. See `src/lib/storage/` for the put/delete path.
model ArticleAudio {
  id                BigInt    @id @default(autoincrement())
  ojs_journal_id    String    @db.VarChar(50)
  submission_id     BigInt
  locale            String    @default("") @db.VarChar(14)
  storage_key       String    @db.VarChar(500)
  mime_type         String    @db.VarChar(100)
  size_bytes        BigInt
  original_filename String    @db.VarChar(255)
  duration_seconds  Int?
  uploaded_by       BigInt
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt
  uploader          AdminUser @relation("UploadedBy", fields: [uploaded_by], references: [id])

  @@unique([ojs_journal_id, submission_id, locale], map: "uq_article_audio_journal_submission_locale")
  @@index([ojs_journal_id, submission_id])
  @@index([uploaded_by])
  @@map("article_audio")
}

/// Observability ledger for every recurring-job execution (OJS sync, metrics
/// aggregation, retention cleanup) regardless of trigger path. This is the
/// shared-hosting substitute for a job queue: locking stays in
/// `system_settings` (`ojs_sync_lock`), SyncRun is the audit trail the
/// admin sync-health widget reads.
model SyncRun {
  id           BigInt    @id @default(autoincrement())
  job_name     String    @db.VarChar(100)
  status       String    @default("running") @db.VarChar(20)
  triggered_by String    @db.VarChar(20)
  started_at   DateTime  @default(now())
  finished_at  DateTime?
  stats        Json?
  error        String?   @db.Text

  @@index([job_name, started_at])
  @@index([status])
  @@map("sync_runs")
}

/// Per-journal aggregate snapshot mirrored from OJS by the sync job so the
/// admin dashboard never reads OJS MySQL on the request path. One row per
/// journal, upserted each sync run. OJS stays canonical (master-slave,
/// pull-only) — this is a cache with provenance, not a source of truth.
model OjsJournalSnapshot {
  id                    BigInt    @id @default(autoincrement())
  journal_id            BigInt    @unique
  article_count         Int       @default(0)
  issue_count           Int       @default(0)
  latest_publication_at DateTime?
  views_total           BigInt    @default(0)
  downloads_total       BigInt    @default(0)
  captured_at           DateTime  @default(now())
  journal               Journal   @relation(fields: [journal_id], references: [id], onDelete: Cascade)

  @@map("ojs_journal_snapshots")
}
